# cmake -DOUT=resources.cpp -DFILES="name=path;name=path;..." -P embed.cmake
# Writes the files as byte arrays and fm1::findResource (src/resources.h). A path that does not exist is left out
# (conv.wasm needs Emscripten: without it the editor's converter says it is unavailable).
set(body "/* generated by plugin/cmake/embed.cmake: do not edit */\n#include \"resources.h\"\n#include <cstring>\n\nnamespace fm1 {\nnamespace {\n")
set(table "")
set(n 0)
foreach(pair ${FILES})
    string(FIND "${pair}" "=" eq)
    string(SUBSTRING "${pair}" 0 ${eq} name)
    math(EXPR from "${eq} + 1")
    string(SUBSTRING "${pair}" ${from} -1 path)
    if(NOT EXISTS "${path}")
        continue()
    endif()
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
    string(APPEND body "const uint8_t r${n}[] = {\n${hex}0};\n")
    string(APPEND table "    {\"${name}\", r${n}, ${size}},\n")
    math(EXPR n "${n} + 1")
endforeach()
string(APPEND body "const Resource all[] = {\n${table}};\n}  // namespace\n\n")
string(APPEND body "const Resource *findResource(const std::string &path)\n{\n    for (const auto &r : all)\n        if (path == r.path)\n            return &r;\n    return nullptr;\n}\n\n}  // namespace fm1\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
